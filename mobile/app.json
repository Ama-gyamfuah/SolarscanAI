{
  "expo": {
    "name": "SolarScan AI",
    "slug": "solarscan-ai",
    "version": "3.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.solarscan.ai",
      "versionCode": 34,
      "largeHeap": true,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "SolarScan AI needs access to your camera to scan and inspect solar panels for defects."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SolarScan AI needs access to your photos to upload solar panel images for defect inspection."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4918b7f9-be00-402a-ad19-b11f10e39e08"
      }
    },
    "owner": "itzgustavos-team"
  }
}
